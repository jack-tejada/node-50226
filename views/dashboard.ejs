<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef2f7;
            font-family: system-ui, -apple-system, sans-serif;
            color: #1f2937;
        }
        .caja {
            width: 100%;
            max-width: 360px;
            margin: 16px;
            background: #fff;
            padding: 32px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
            text-align: center;
        }
        h1 { margin: 0 0 4px; font-size: 24px; }
        .subtitulo { margin: 0 0 20px; color: #6b7280; font-size: 14px; }
        .email {
            margin: 0 0 20px;
            padding: 12px;
            background: #eff6ff;
            border-radius: 8px;
            color: #1d4ed8;
            font-weight: 600;
            word-break: break-all;
        }
        .nota { margin: 0 0 20px; color: #6b7280; font-size: 13px; }
        button {
            width: 100%;
            padding: 11px;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }
        button:hover { background: #1d4ed8; }
    </style>
</head>
<body>
    <div class="caja">
        <h1>Panel</h1>
        <p class="subtitulo">Sesión iniciada como</p>
        <p class="email" id="email">Cargando...</p>
        <p class="nota">El token se renueva solo cuando vence.</p>
        <button id="salir">Cerrar sesión</button>
    </div>

    <script>
        const token = localStorage.getItem('token')
        if (!token) {
            location.href = '/login'
        } else {
            cargarDashboard(token)
        }

        async function cargarDashboard(token) {
            const respuesta = await fetch('/dashboard', {
                headers: { Authorization: 'Bearer ' + token }
            })
            if (respuesta.status === 401) {
                const refresh = await fetch('/auth/refresh', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token })
                })
                if (!refresh.ok) {
                    localStorage.removeItem('token')
                    location.href = '/login'
                    return
                }
                const nuevoToken = await refresh.text()
                localStorage.setItem('token', nuevoToken)
                return cargarDashboard(nuevoToken)
            }
            const data = await respuesta.json()
            document.getElementById('email').textContent = data.email
        }

        document.getElementById('salir').addEventListener('click', () => {
            localStorage.removeItem('token')
            location.href = '/login'
        })
    </script>
</body>
</html>

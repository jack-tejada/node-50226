<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef2f7;
            font-family: system-ui, -apple-system, sans-serif;
            color: #1f2937;
        }
        .caja {
            width: 100%;
            max-width: 360px;
            margin: 16px;
            background: #fff;
            padding: 32px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
        }
        h1 { margin: 0 0 4px; font-size: 24px; }
        .subtitulo { margin: 0 0 24px; color: #6b7280; font-size: 14px; }
        label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 600; }
        input {
            width: 100%;
            padding: 10px 12px;
            margin-bottom: 16px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 15px;
        }
        input:focus { outline: 2px solid #2563eb; border-color: transparent; }
        button {
            width: 100%;
            padding: 11px;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }
        button:hover { background: #1d4ed8; }
        button:disabled { background: #93c5fd; cursor: default; }
        #mensaje { min-height: 20px; margin: 12px 0 0; color: #dc2626; font-size: 14px; text-align: center; }
    </style>
</head>
<body>
    <form class="caja" id="formulario">
        <h1>Iniciar sesión</h1>
        <p class="subtitulo">Panel del administrador</p>

        <label for="email">Correo</label>
        <input type="email" id="email" placeholder="admin@tienda.com" autocomplete="email" required>

        <label for="password">Contraseña</label>
        <input type="password" id="password" placeholder="Tu contraseña" autocomplete="current-password" required>

        <button type="submit" id="boton">Entrar</button>
        <p id="mensaje"></p>
    </form>

    <script>
        const formulario = document.getElementById('formulario')
        const boton = document.getElementById('boton')
        const mensaje = document.getElementById('mensaje')

        formulario.addEventListener('submit', async (evento) => {
            evento.preventDefault()
            boton.disabled = true
            boton.textContent = 'Entrando...'
            mensaje.textContent = ''

            const email = document.getElementById('email').value
            const password = document.getElementById('password').value
            const respuesta = await fetch('/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            })

            if (!respuesta.ok) {
                const error = await respuesta.json()
                mensaje.textContent = error.message || error.error
                boton.disabled = false
                boton.textContent = 'Entrar'
                return
            }

            const token = await respuesta.text()
            localStorage.setItem('token', token)
            location.href = '/panel'
        })
    </script>
</body>
</html>
